<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <ItemGroup>
    <ProjectReference Include="..\OrderSystem.Api\OrderSystem.Api.csproj" />
    <ProjectReference Include="..\OrderSystem.MigrationService\OrderSystem.MigrationService.csproj" />
    <ProjectReference Include="..\OrderSystem.NotificationService\OrderSystem.NotificationService.csproj" />
    <!-- Unchanged relative paths: Api/MigrationService/NotificationService all moved into
         hosts/ alongside AppHost, so the sibling relationship (..\) is preserved. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Kafka" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.6.4" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>e164a1a6-270d-41e7-90a8-9e44e5476a43</UserSecretsId>
    <!-- ASPIRE010: from Aspire 13.6 on, the SDK defaults AspireUseCliBundle=false and
         warns about it. This project deliberately keeps the package-based dashboard/DCP
         setup it has always used (runs via `dotnet run` and Aspire.Hosting.Testing,
         no Aspire CLI), so the warning carries no action for us. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);ASPIRE010</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets OrderSystem.EndToEndTests reference the top-level-statement Program
         class (internal by default) via DistributedApplicationTestingBuilder. -->
    <InternalsVisibleTo Include="OrderSystem.EndToEndTests" />
  </ItemGroup>

</Project>
