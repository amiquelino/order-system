<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Domain\OrderSystem.Domain\OrderSystem.Domain.csproj" />
    <!-- Needed to implement IOrderFulfillmentSagaRepository, an Application-level
         port (like IPaymentGateway) rather than a Domain one — adapters depending
         on Application to implement its ports is the normal hexagonal direction. -->
    <ProjectReference Include="..\..\Application\OrderSystem.Application\OrderSystem.Application.csproj" />
  </ItemGroup>

  <!--
    EF Core stays on the 10.x line on .NET 11 (spec 007, FR-006; research.md Decision 2).
    Why: Npgsql.EntityFrameworkCore.PostgreSQL has no stable 11.x yet (only
    11.0.0-rc.3), and 10.0.3 requires EF Core [10.0.4, 11.0.0).
    Exit: when the Npgsql provider ships stable 11.0.0, move EF Core, EF Core
    Design (here and in OrderSystem.MigrationService), the dotnet-ef tool
    (.config/dotnet-tools.json) and the provider to 11.x together.

    Relational is referenced directly because this adapter uses its APIs
    (ToTable, migrations). Without it, projects referencing this adapter get
    Relational 10.0.4 from Npgsql's lower bound instead of 10.0.15 (MSB3277).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
